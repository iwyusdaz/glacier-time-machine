{
  "name": "glacier-time-machine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stand in a real-scale 3D Muir Inlet beside genuine USGS repeat photographs from 1941, 1950 and 2004: compare the photos, measure the glacier's retreat and its lower-bound rate, and argue from evidence about what caused it and what comes next.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/sync-content.mjs && node scripts/build-sources.mjs && vite",
    "build": "node scripts/sync-content.mjs && node scripts/build-sources.mjs && node scripts/build-attribution.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:subpath": "playwright test tests/sub-path.spec.js",
    "check:a11y": "playwright test tests/a11y.spec.js",
    "data:fetch": "bash scripts/fetch-data.sh",
    "data:dem": "bash scripts/process-dem.sh",
    "data:photos": "bash scripts/process-photos.sh",
    "build:attribution": "node scripts/build-attribution.mjs",
    "build:sources": "node scripts/build-sources.mjs",
    "validate:showcase": "node scripts/validate-showcase.mjs 1.0.0"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
